# lg-scraper — copy to .env and fill in what you actually have.
#
#   cp .env.example .env
#   python3 env_config.py      # says what was picked up, WITHOUT printing it
#
# Nothing here is required: with no .env at all the scrapers still run, and
# on this site they still return complete data — the catalogue API answers a
# plain HTTPS POST with no credential of any kind (see the README).
#
# Precedence, highest first:
#   an explicit CLI flag  >  an exported environment variable  >  this file
#
# Every value below is a PLACEHOLDER. A value still carrying {braces} is
# treated as unset, so a copied example can never be sent to an API as if it
# were a key — that mistake produces a 401 a long way from its cause.

# 2Captcha API key. One key, four separately-billed products: captcha
# solving, the Scraping Browser API, proxies and fingerprints.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# Scraping Browser API endpoint (https://2captcha.com/scraper/browser-api).
#   country-xx  picks the exit country
#   pid-...     is a profile with persistent cookies — ONE live connection
#               each, so reuse pids rather than minting one per run
LG_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-de-pid-{profileId}:{password}@cb.2captcha.com:9222

# A proxy for the engines that launch their own browser
# (https://2captcha.com/proxy, also sold as 2prx.com — the same product).
LG_PROXY=http://{user}:{password}@us.proxy.2captcha.com:2334

# A default listing URL, so --url can be omitted.
LG_URL=https://www.lg.com/ru/televisions
